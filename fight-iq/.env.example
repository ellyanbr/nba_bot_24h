# Copie para .env.local (não versionado). Todas as variáveis são OPCIONAIS.

# Armazenamento: local (padrão, arquivo JSON) | supabase
DATA_BACKEND=local
# LOCAL_DB_PATH=./data/fightiq.local.json

# Supabase (somente se DATA_BACKEND=supabase) — usadas apenas no servidor
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# IA: none (padrão) | ollama | openai_compatible
AI_PROVIDER=none
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=
# AI_API_KEY=
# AI_TIMEOUT_MS=180000

# Proteção opcional por senha (HTTP Basic Auth) em todas as páginas.
# Recomendado se usar `npm run start:lan`. Fora da sua máquina, apenas com HTTPS.
# APP_BASIC_AUTH_USER=
# APP_BASIC_AUTH_PASSWORD=
